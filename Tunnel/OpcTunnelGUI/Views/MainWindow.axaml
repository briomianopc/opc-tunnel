<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpcTunnelGUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="OpcTunnelGUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="OPC Tunnel - 网络隧道客户端"
        Width="900" Height="700"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.header">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#FF2196F3"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.success">
            <Setter Property="Background" Value="#FF4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#FFF44336"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题和状态栏 -->
        <Border Grid.Row="0" Background="#FF2196F3" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="OPC Tunnel" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="基于 ECH 的网络隧道客户端" FontSize="12" Foreground="#FFBBDEFB"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Border Background="{Binding StatusColor}" CornerRadius="12" Padding="12,6">
                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 配置区域 -->
        <Border Grid.Row="1" Background="#FFF5F5F5" CornerRadius="8" Padding="20" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="连接配置" Classes="header"/>

                <!-- 基本配置 -->
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,10">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="服务器地址:" Classes="label"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.ServerAddress}" 
                             Watermark="例如: your-worker.workers.dev:443"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="身份令牌:" Classes="label"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.Token}" 
                             Watermark="UUID 或 Token"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="监听地址:" Classes="label"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.ListenAddress}" 
                             Watermark="127.0.0.1:30000"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="传输模式:" Classes="label"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" SelectedItem="{Binding Config.TransportMode}" Margin="0,5">
                        <ComboBoxItem Content="WebSocket (ws)" Tag="ws" IsSelected="True"/>
                        <ComboBoxItem Content="gRPC" Tag="grpc"/>
                    </ComboBox>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="并发连接数:" Classes="label"/>
                    <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding Config.NumConnections}" 
                                   Minimum="1" Maximum="10" Margin="0,5"/>
                </Grid>

                <!-- 高级设置切换 -->
                <Button Content="{Binding ShowAdvancedSettings, Converter={StaticResource BoolToTextConverter}}" 
                        Command="{Binding ToggleAdvancedSettingsCommand}"
                        HorizontalAlignment="Left"/>

                <!-- 高级设置 -->
                <Border IsVisible="{Binding ShowAdvancedSettings}" Margin="0,10,0,0" 
                        Background="White" CornerRadius="4" Padding="15">
                    <StackPanel>
                        <TextBlock Text="高级设置" FontWeight="Bold" Margin="0,0,0,10"/>
                        
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="优选 IP:" Classes="label"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.ServerIP}" 
                                     Watermark="可选，CDN 优选 IP 或 CNAME 域名"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="DNS 服务器:" Classes="label"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.DnsServer}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="ECH 域名:" Classes="label"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.EchDomain}"/>

                            <CheckBox Grid.Row="3" Grid.Column="1" Content="禁用 ECH (Fallback 模式)" 
                                      IsChecked="{Binding Config.UseFallback}" Margin="0,5"/>

                            <CheckBox Grid.Row="4" Grid.Column="1" Content="启用 TUN 模式 (需要管理员权限)" 
                                      IsChecked="{Binding Config.EnableTunMode}" Margin="0,5"/>

                            <CheckBox Grid.Row="5" Grid.Column="1" Content="自动设置系统代理" 
                                      IsChecked="{Binding Config.EnableSystemProxy}" Margin="0,5"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 日志区域 -->
        <Border Grid.Row="2" Background="#FFF5F5F5" CornerRadius="8" Padding="15">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBlock Text="运行日志" Classes="header"/>
                    <Button Grid.Column="1" Content="清除日志" Command="{Binding ClearLogsCommand}"/>
                </Grid>

                <Border Grid.Row="1" Background="White" CornerRadius="4" BorderBrush="#FFDDDDDD" BorderThickness="1">
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding LogMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="5,2" FontFamily="Consolas,Courier New"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- 控制按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="连接" 
                    Command="{Binding ConnectCommand}"
                    IsEnabled="{Binding !IsConnected}"
                    Classes="success"
                    Width="120"/>
            <Button Content="断开" 
                    Command="{Binding DisconnectCommand}"
                    IsEnabled="{Binding IsConnected}"
                    Classes="danger"
                    Width="120"/>
        </StackPanel>
    </Grid>
</Window>
